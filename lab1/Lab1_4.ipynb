    "def collatz_generator(n):\n",
    "    yield n\n",
    "    while n > 1:\n",
    "        if n % 2 == 0:\n",
    "            n = n // 2\n",
    "        else:\n",
    "            n = 3 * n + 1\n",
    "        yield n\n",
    "\n",
    "# Test:\n",
    "for status in collatz_generator(18):\n",
    "    print(status)"
   ]
  }
